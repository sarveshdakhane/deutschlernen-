{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "deutsch-lernen",
	"main": "workers/entry.ts",
	"compatibility_date": "2026-10-20",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "deutsch-lernen"
		}
	],
	"r2_buckets": [
		{
			// Application content cache — replaces Vercel Blob. Holds readings JSON,
			// preposition JSON, pronunciation clips, the vocabulary-cooldown record,
			// and proxied topic images. See lib/storage.server.ts.
			"binding": "CONTENT_BUCKET",
			"bucket_name": "deutsch-lernen-content"
		}
	],
	"images": {
		"binding": "IMAGES"
	},

	"routes": [
		{ "pattern": "dailydeutsch.org", "custom_domain": true },
		{ "pattern": "www.dailydeutsch.org", "custom_domain": true }
	],

	// Per-IP rate limits enforced in workers/entry.ts before Next.js runs.
	// Static assets are served before the worker and don't count. namespace_id
	// just needs to be a unique integer string within the Cloudflare account.
	"ratelimits": [
		{ "name": "PAGE_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
		{ "name": "API_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
	],

	"durable_objects": {
		"bindings": [
			{
				"name": "GENERATION_COORDINATOR",
				"class_name": "GenerationCoordinatorDO"
			}
		]
	},
	"exports": {
		"GenerationCoordinatorDO": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},

	"triggers": {
		// Daily content rollover. UTC — adjust if the desired local rollover time
		// changes (Germany is UTC+1/+2 depending on DST).
		"crons": ["0 22 * * *"]
	}
}
